                        Message on WhatsApp
                    </a>

                </div>

            </div>


            <aside class="contact-details-card">

                <div class="contact-detail">
                    <h2 class="contact-detail-label">
                        Email
                    </h2>

                    <a
                        href="mailto:info@marjheerdy.com"
                        class="contact-detail-value"
                    >
                        info@marjheerdy.com
                    </a>
                </div>


                <div class="contact-detail">
                    <h2 class="contact-detail-label">
                        WhatsApp
                    </h2>

                    <a
                        href="https://wa.me/447454758903"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="contact-whatsapp-button"
                    >
                        Message on WhatsApp
                    </a>
                </div>


                <p class="contact-detail-note">
                    No phone call required. We're happy to work through
                    everything over email or WhatsApp.
                </p>

            </aside>

        </div>

    </div>
</section>