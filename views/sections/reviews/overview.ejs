<style>
    /* ==============================
   Reviews Overview
============================== */

.reviews-overview-section {
    padding: 64px 0;
}

.reviews-overview-container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
}

.reviews-overview-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    border: 1px solid #e5e5e5;
    background: #e5e5e5;
}

.reviews-overview-stat {
    padding: 24px;
    background: #ffffff;
}

.reviews-overview-label {
    color: #737373;
    font-family: monospace;
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: 0.15em;
    text-transform: uppercase;
}

.reviews-overview-value {
    margin-top: 8px;
    color: #171717;
    font-size: 30px;
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: -0.025em;
}

.reviews-empty-state {
    margin-top: 64px;
    padding: 48px;
    border: 1px dashed #e5e5e5;
    background: #ffffff;
}

.reviews-empty-state h2 {
    margin: 0;
    color: #171717;
    font-size: 26px;
    line-height: 1.25;
    font-weight: 800;
    letter-spacing: -0.02em;
}

.reviews-empty-state p {
    max-width: 60ch;
    margin: 16px 0 0;
    color: #737373;
    font-size: 16px;
    line-height: 1.7;
}

.reviews-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-top: 50px;
}

.review-card {
    padding: 28px;
    border: 1px solid #e5e5e5;
    border-radius: 18px;
    background: #ffffff;
}

.review-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 22px;
}

.review-card-author h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    color: #111111;
}

.review-card-author p {
    margin: 6px 0 0;
    color: #777777;
    font-size: 14px;
}

.review-card-rating {
    display: flex;
    gap: 3px;
    white-space: nowrap;
    color: #d5d5d5;
    font-size: 18px;
}

.review-card-rating span.is-active {
    color: #111111;
}

.review-card-body {
    margin-bottom: 20px;
}

.review-card-body p {
    margin: 0;
    color: #444444;
    font-size: 15px;
    line-height: 1.8;
}

.review-card-service {
    display: inline-flex;
    padding: 7px 12px;
    border-radius: 999px;
    background: #f3f3f3;
    color: #555555;
    font-size: 12px;
}

@media (max-width: 768px) {
    .reviews-list {
        grid-template-columns: 1fr;
        gap: 16px;
        margin-top: 35px;
    }

    .review-card {
        padding: 22px;
    }

    .review-card-header {
        flex-direction: column;
        gap: 12px;
    }
}

/* ==============================
   Responsive
============================== */

@media (max-width: 767px) {
    .reviews-overview-section {
        padding: 48px 0;
    }

    .reviews-overview-container {
        padding: 0 20px;
    }

    .reviews-overview-stats {
        grid-template-columns: 1fr;
    }

    .reviews-overview-stat {
        padding: 20px;
    }

    .reviews-overview-value {
        font-size: 26px;
    }

    .reviews-empty-state {
        margin-top: 48px;
        padding: 32px 24px;
    }

    .reviews-empty-state h2 {
        font-size: 23px;
    }
}
</style>

<section class="reviews-overview-section">
    <div class="reviews-overview-container">

        <div class="reviews-overview-stats">

            <div class="reviews-overview-stat">
                <div class="reviews-overview-label">
                    Published reviews
                </div>

                <div class="reviews-overview-value">
                    <%= publishedReviewsCount %>
                </div>
            </div>

            <div class="reviews-overview-stat">
                <div class="reviews-overview-label">
                    Average rating
                </div>

                <div class="reviews-overview-value">
                    <%= averageRating || "—" %>
                    <% if (averageRating) { %>
                        <span> / 5</span>
                    <% } %>
                </div>
            </div>

            <div class="reviews-overview-stat">
                <div class="reviews-overview-label">
                    Source
                </div>

                <div class="reviews-overview-value">
                    Clients only
                </div>
            </div>

        </div>

        <% if (reviews && reviews.length > 0) { %>

            <div class="reviews-list">

                <% reviews.forEach((review) => { %>

                    <article class="review-card">

                        <div class="review-card-header">

                            <div class="review-card-author">
                                <h3>
                                    <%= review.reviewerName %>
                                </h3>

                                <% if (review.storeName) { %>
                                    <p>
                                        <%= review.storeName %>
                                    </p>
                                <% } %>
                            </div>

                            <div
                                class="review-card-rating"
                                aria-label="<%= review.rating %> out of 5 stars"
                            >
                                <% for (let i = 1; i <= 5; i++) { %>
                                    <span class="<%= i <= review.rating ? 'is-active' : '' %>">
                                        ★
                                    </span>
                                <% } %>
                            </div>

                        </div>

                        <div class="review-card-body">
                            <p>
                                <%= review.body %>
                            </p>
                        </div>

                        <% if (review.service) { %>
                            <div class="review-card-service">
                                <%= review.service %>
                            </div>
                        <% } %>

                    </article>

                <% }) %>

            </div>

        <% } else { %>

            <div class="reviews-empty-state">
                <h2>
                    No reviews published yet
                </h2>

                <p>
                    We would rather show an empty page than an invented one.
                    If we have worked on your Shopify store, your review can
                    be the first one here.
                </p>
            </div>

        <% } %>

    </div>
</section>