    color: #111111;

    font-size: 20px;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.02em;
}


/* ========================================
   Tablet
======================================== */

@media (max-width: 1023px) {

    .home-videos-section {
        padding: 80px 0;
    }

    .home-videos-header {
        grid-template-columns: 1fr;
        gap: 20px;
    }

    .home-videos-title {
        max-width: 24ch;
    }

    .home-videos-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .home-video-card:last-child {
        grid-column: 1 / -1;
        max-width: calc(50% - 12px);
    }

}


/* ========================================
   Mobile
======================================== */

@media (max-width: 640px) {

    .home-videos-section {
        padding: 64px 0;
    }

    .home-videos-container {
        padding: 0 20px;
    }

    .home-videos-header {
        margin-bottom: 32px;
    }

    .home-videos-title {
        font-size: 38px;
    }

    .home-videos-description {
        font-size: 15px;
    }

    .home-videos-grid {
        grid-template-columns: 1fr;
        gap: 20px;
    }

    .home-video-card:last-child {
        grid-column: auto;
        max-width: none;
    }

    .home-video-content {
        padding: 20px;
    }

    .home-video-title {
        font-size: 18px;
    }

}


/* ========================================
   Small Mobile
======================================== */

@media (max-width: 380px) {

