    margin: 0 auto;
    padding: 0 24px;

    box-sizing: border-box;
}


/* ========================================
   Section Header
======================================== */

.home-videos-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.7fr);
    align-items: end;
    gap: 48px;

    margin-bottom: 40px;
}

.home-videos-label {
    margin: 0 0 20px;

    color: #737373;

    font-family: monospace;
    font-size: 10px;
    font-weight: 700;
    line-height: 1.5;

    text-transform: uppercase;
    letter-spacing: 0.15em;
}

.home-videos-title {
    max-width: 20ch;

    margin: 0;

    color: #111111;

    font-size: clamp(36px, 4vw, 56px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.04em;
}

.home-videos-description {
    max-width: 48ch;

    margin: 0;

    color: #737373;

    font-size: 16px;
    line-height: 1.7;
}


/* ========================================
   Video Grid
======================================== */

.home-videos-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
}

.home-video-card {
    min-width: 0;

    border: 1px solid #e5e5e5;
    background: #ffffff;

    overflow: hidden;
}

.home-video-wrapper {
    position: relative;

    width: 100%;

    aspect-ratio: 16 / 9;

    overflow: hidden;

    background: #f5f5f5;
}

.home-video-wrapper iframe {
    display: block;

    width: 100%;
    height: 100%;

    border: 0;
}

.home-video-content {
