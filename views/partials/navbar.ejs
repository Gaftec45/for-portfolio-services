<style>
/* ========================================
   NAVBAR
======================================== */

.site-header {
    width: 100%;
    background: #ffffff;
    border-bottom: 1px solid #e5e5e5;
    position: relative;
    z-index: 1000;
}

.navbar-container {
    width: 100%;
    max-width: 1280px;
    min-height: 64px;
    margin: 0 auto;
    padding: 0 24px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    box-sizing: border-box;
}


/* ========================================
   Logo + Left Side
======================================== */

.navbar-left {
    min-width: 0;

    display: flex;
    align-items: center;
    gap: 32px;
}

.navbar-logo {
    flex-shrink: 0;

    display: flex;
    align-items: center;

    text-decoration: none;
}

.logo-image {
    display: block;
    width: auto;
    height: 36px;
}


/* ========================================
   Desktop Navigation
======================================== */

.desktop-nav {
    display: flex;
    align-items: center;
    gap: 22px;

    font-size: 14px;
    font-weight: 500;
}

.desktop-nav a {
    position: relative;

    padding: 4px 0;

    color: #737373;
    text-decoration: none;

    white-space: nowrap;

    transition: color 0.2s ease;
}

.desktop-nav a:hover {
    color: #111111;
}

.desktop-nav a.active {
    color: #111111;
}


/* ========================================
   Right Side
======================================== */

.navbar-right {
    flex-shrink: 0;

    display: flex;
    align-items: center;
    gap: 10px;
}

.navbar-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 40px;
    padding: 9px 16px;

    border: 1px solid #111111;
    border-radius: 4px;

    background: #111111;
    color: #ffffff;

    font-size: 14px;
    font-weight: 600;

    line-height: 1;
    white-space: nowrap;

    text-decoration: none;

    transition:
        background-color 0.2s ease,
        border-color 0.2s ease;
}

.navbar-cta:hover {
    background: #333333;
    border-color: #333333;
}


/* ========================================
   Mobile Menu Button
======================================== */

.mobile-menu-button {
    display: none;

    width: 42px;
    height: 42px;

    padding: 0;

    border: 1px solid #e5e5e5;
    border-radius: 4px;

    background: #ffffff;

    cursor: pointer;

    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;

    transition:
        background-color 0.2s ease,
        border-color 0.2s ease;
}

.mobile-menu-button:hover {
    background: #f7f7f7;
    border-color: #d4d4d4;
}

.mobile-menu-button span {
    display: block;

    width: 19px;
    height: 1.5px;

    background: #111111;

    transition:
        transform 0.2s ease,
        opacity 0.2s ease;
}


/* ========================================
   Mobile Navigation
======================================== */

.mobile-nav {
    display: none;

    width: 100%;

    padding: 12px 24px 24px;

    border-top: 1px solid #e5e5e5;

    background: #ffffff;

    flex-direction: column;
    gap: 0;

    box-sizing: border-box;
}

.mobile-nav a {
    display: block;

    padding: 13px 0;

    border-bottom: 1px solid #f0f0f0;

    color: #737373;

    font-size: 15px;
    font-weight: 500;

    line-height: 1.4;

    text-decoration: none;

    transition: color 0.2s ease;
}

.mobile-nav a:hover {
    color: #111111;
}


/* ========================================
   Mobile CTA
======================================== */

.mobile-nav-cta {
    margin-top: 16px;

    padding: 13px 16px !important;

    border: 1px solid #111111 !important;
    border-radius: 4px;

    background: #111111;

    color: #ffffff !important;

    text-align: center;

    font-weight: 600 !important;
}

.mobile-nav-cta:hover {
    background: #333333;
    color: #ffffff !important;
}


/* ========================================
   Tablet
======================================== */

@media (max-width: 1100px) {

    .navbar-left {
        gap: 24px;
    }

    .desktop-nav {
        gap: 17px;
        font-size: 13px;
    }

    .navbar-cta {
        padding: 9px 14px;
        font-size: 13px;
    }
}


/* ========================================
   Tablet / Mobile
======================================== */

@media (max-width: 1023px) {

    .navbar-container {
        min-height: 64px;
    }

    .desktop-nav {
        display: none;
    }

    .mobile-menu-button {
        display: flex;
    }

    .navbar-left {
        gap: 0;
    }
}


/* ========================================
   Small Tablets
======================================== */

@media (max-width: 767px) {

    .navbar-container {
        min-height: 60px;
        padding: 0 20px;
    }

    .logo-image {
        height: 34px;
    }

    .navbar-cta {
        display: none;
    }

    .mobile-menu-button {
        width: 40px;
        height: 40px;
    }

    .mobile-nav {
        padding-left: 20px;
        padding-right: 20px;
    }
}


/* ========================================
   Phones
======================================== */

@media (max-width: 480px) {

    .navbar-container {
        min-height: 58px;
        padding: 0 16px;
    }

    .logo-image {
        height: 32px;
    }

    .mobile-menu-button {
        width: 38px;
        height: 38px;
    }

    .mobile-nav {
        padding:
            10px
            16px
            20px;
    }

    .mobile-nav a {
        padding: 12px 0;
        font-size: 14px;
    }
}


/* ========================================
   Very Small Phones
======================================== */

@media (max-width: 360px) {

    .navbar-container {
        padding: 0 14px;
    }

    .logo-image {
        height: 30px;
    }

    .mobile-menu-button {
        width: 36px;
        height: 36px;
    }

    .mobile-menu-button span {
        width: 17px;
    }

    .mobile-nav {
        padding-left: 14px;
        padding-right: 14px;
    }
}
</style>


<header class="site-header">

    <div class="navbar-container">

        <!-- Logo + Desktop Navigation -->

        <div class="navbar-left">

            <a
                href="/"
                class="navbar-logo"
                aria-label="Marjheerdy home"
            >
                <img
                    src="https://marjheerdy.lovable.app/__l5e/assets-v1/53093516-bf24-4c7d-befc-3a3280eec5a3/marjheerdy-logo.png"
                    alt="Marjheerdy logo"
                    class="logo-image"
                >
            </a>


            <nav
                class="desktop-nav"
                aria-label="Main navigation"
            >

                <a
                    href="/about"
                    class="<%= currentPath === '/about' ? 'active' : '' %>"
                >
                    About
                </a>

                <a
                    href="/services"
                    class="<%= currentPath === '/services' ? 'active' : '' %>"
                >
                    Services
                </a>

                <a
                    href="/packages"
                    class="<%= currentPath === '/packages' ? 'active' : '' %>"
                >
                    Packages
                </a>

                <a
                    href="/case-studies"
                    class="<%= currentPath === '/case-studies' ? 'active' : '' %>"
                >
                    Case Studies
                </a>

                <a
                    href="/reviews"
                    class="<%= currentPath === '/reviews' ? 'active' : '' %>"
                >
                    Reviews
                </a>

                <a
                    href="/faq"
                    class="<%= currentPath === '/faq' ? 'active' : '' %>"
                >
                    FAQ
                </a>

                <a
                    href="/contact"
                    class="<%= currentPath === '/contact' ? 'active' : '' %>"
                >
                    Contact
                </a>

            </nav>

        </div>


        <!-- CTA + Mobile Menu -->

        <div class="navbar-right">

            <a
                href="/contact"
                class="navbar-cta"
            >
                Discuss Your Store
            </a>


            <button
                type="button"
                id="mobile-menu-button"
                class="mobile-menu-button"
                aria-expanded="false"
                aria-controls="mobile-nav"
                aria-label="Open navigation menu"
            >
                <span></span>
                <span></span>
                <span></span>
            </button>

        </div>

    </div>


    <!-- Mobile Navigation -->

    <nav
        id="mobile-nav"
        class="mobile-nav"
        aria-label="Mobile navigation"
    >

        <a href="/about">
            About
        </a>

        <a href="/services">
            Services
        </a>

        <a href="/packages">
            Packages
        </a>

        <a href="/case-studies">
            Case Studies
        </a>

        <a href="/reviews">
            Reviews
        </a>

        <a href="/faq">
            FAQ
        </a>

        <a href="/contact">
            Contact
        </a>


        <a
            href="/contact"
            class="mobile-nav-cta"
        >
            Discuss Your Store
        </a>

    </nav>

</header>


<script>

const mobileMenuButton =
    document.getElementById("mobile-menu-button");

const mobileNav =
    document.getElementById("mobile-nav");


if (mobileMenuButton && mobileNav) {

    mobileMenuButton.addEventListener("click", () => {

        const isOpen =
            mobileMenuButton.getAttribute("aria-expanded") === "true";


        mobileMenuButton.setAttribute(
            "aria-expanded",
            String(!isOpen)
        );


        mobileMenuButton.setAttribute(
            "aria-label",
            isOpen
                ? "Open navigation menu"
                : "Close navigation menu"
        );


        mobileNav.style.display =
            isOpen
                ? "none"
                : "flex";

    });

}

</script>