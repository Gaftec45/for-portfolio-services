<style>
    /* ========================================
Footer
======================================== */

.site-footer {
border-top: 1px solid #e5e5e5;
padding: 80px 0;
background: #ffffff;
}

.footer-container {
width: 100%;
max-width: 1280px;
margin: 0 auto;
padding: 0 24px;


display: grid;
grid-template-columns:
    repeat(6, minmax(0, 1fr));

gap: 48px;


}

/* ========================================
Brand
======================================== */

.footer-brand {
grid-column: span 2;
}

.footer-logo {
height: 40px;
width: auto;
display: block;
}

.footer-description {
max-width: 32ch;
margin-top: 16px;


font-size: 14px;
line-height: 1.6;

color: #737373;


}

.footer-copyright {
margin-top: 32px;


font-family: monospace;
font-size: 12px;

color: #737373;


}

/* ========================================
Footer Columns
======================================== */

.footer-column h2,
.footer-contact h2 {
margin: 0 0 16px;


font-size: 14px;
font-weight: 700;


}

.footer-column ul {
margin: 0;
padding: 0;


list-style: none;

display: flex;
flex-direction: column;
gap: 8px;


}

.footer-column a,
.contact-email a {
color: #737373;


font-size: 14px;

text-decoration: none;

transition: color 0.2s ease;


}

.footer-column a:hover,
.contact-email a:hover,
.social-links a:hover {
color: #111111;
}

/* ========================================
Contact
======================================== */

.footer-contact {
grid-column: span 2;
}

.contact-email {
margin: 0 0 16px;
}

.contact-actions {
display: flex;
flex-wrap: wrap;
gap: 8px;
}

.whatsapp-button {
display: inline-flex;
align-items: center;


padding: 8px 12px;

border: 1px solid #e5e5e5;
border-radius: 4px;

color: #111111;

font-family: monospace;
font-size: 12px;

text-decoration: none;

transition:
    background 0.2s ease,
    color 0.2s ease;


}

.whatsapp-button:hover {
background: #111111;
color: #ffffff;
}

/* ========================================
Social Links
======================================== */

.social-links {
margin: 24px 0 0;
padding: 0;


display: flex;
gap: 16px;

list-style: none;


}

.social-links a {
color: #737373;


font-family: monospace;
font-size: 12px;

text-decoration: none;

transition: color 0.2s ease;


}

/* ========================================
Tablet
======================================== */

@media (max-width: 900px) {


.footer-container {
    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 40px;
}

.footer-brand,
.footer-contact {
    grid-column: span 2;
}


}

/* ========================================
Mobile
======================================== */

@media (max-width: 600px) {


.site-footer {
    padding: 60px 0;
}

.footer-container {
    grid-template-columns: 1fr;

    gap: 36px;

    padding: 0 20px;
}

.footer-brand,
.footer-contact {
    grid-column: span 1;
}

.footer-logo {
    height: 36px;
}

.social-links {
    flex-wrap: wrap;
}


}

</style>
<footer class="site-footer">


<div class="footer-container">

    <!-- Brand -->
    <div class="footer-brand">

        <img
            src="https://marjheerdy.lovable.app/__l5e/assets-v1/53093516-bf24-4c7d-befc-3a3280eec5a3/marjheerdy-logo.png"
            alt="Marjheerdy logo"
            class="footer-logo"
        >

        <p class="footer-description">
            A Shopify growth agency helping merchants build,
            optimize, and grow stores with practical,
            budget-aware strategy.
        </p>

        <p class="footer-copyright">
            © <%= new Date().getFullYear() %> Marjheerdy.
            All rights reserved.
        </p>

    </div>


    <!-- Pages -->
    <div class="footer-column">

        <h2>Pages</h2>

        <ul>

            <li>
                <a href="/about">About</a>
            </li>

            <li>
                <a href="/services">Services</a>
            </li>

            <li>
                <a href="/packages">Packages</a>
            </li>

            <li>
                <a href="/case-studies">Case Studies</a>
            </li>

            <li>
                <a href="/faq">FAQ</a>
            </li>

            <li>
                <a href="/contact">Contact</a>
            </li>

        </ul>

    </div>


    <!-- Services -->
    <div class="footer-column">

        <h2>Services</h2>

        <ul>

            <li>
                <a href="/services">
                    Store Audit
                </a>
            </li>

            <li>
                <a href="/services">
                    Conversion Optimization
                </a>
            </li>

            <li>
                <a href="/services">
                    Shopify SEO
                </a>
            </li>

            <li>
                <a href="/services">
                    Email &amp; Klaviyo
                </a>
            </li>

        </ul>

    </div>


    <!-- Contact -->
    <div class="footer-contact">

        <h2>Contact</h2>

        <p class="contact-email">
            <a href="mailto:info@marjheerdy.com">
                info@marjheerdy.com
            </a>
        </p>


        <div class="contact-actions">

            <a
                href="https://wa.me/447454758903"
                target="_blank"
                rel="noopener noreferrer"
                class="whatsapp-button"
            >
                WhatsApp
            </a>

        </div>


        <ul class="social-links">

            <li>
                <a
                    href="#"
                    aria-label="LinkedIn (link coming soon)"
                >
                    LinkedIn
                </a>
            </li>

            <li>
                <a
                    href="https://instagram.com/master_marjheerdy"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Instagram"
                >
                    Instagram
                </a>
            </li>

            <li>
                <a
                    href="#"
                    aria-label="X (link coming soon)"
                >
                    X
                </a>
            </li>

        </ul>

    </div>

</div>


</footer>
